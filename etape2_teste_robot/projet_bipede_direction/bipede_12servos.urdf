<?xml version="1.0"?>
<!--
  Bipède : buste + 2 jambes, 12 servomoteurs MG996R (6 par jambe)
  Par jambe : hanche lacet (Z), hanche roulis (X), hanche tangage (Y),
              genou (Y), cheville tangage (Y), cheville roulis (X)
  Limites servo : couple 1.0 N.m, vitesse 7 rad/s
  Hauteur totale ~0.57 m, masse ~1.7 kg
  Généré automatiquement (inerties calculées).
-->
<robot name="bipede_12servos">
  <material name="noir"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="blanc"><color rgba="0.9 0.9 0.9 1"/></material>
  <material name="bleu"><color rgba="0.15 0.4 0.85 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.1 1"/></material>

  <link name="bassin">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.06 0.14 0.04"/></geometry><material name="noir"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><box size="0.06 0.14 0.04"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.2"/>
      <inertia ixx="3.533e-04" iyy="8.667e-05" izz="3.867e-04" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="fix_buste" type="fixed"><parent link="bassin"/><child link="buste"/><origin xyz="0 0 0.02"/></joint>

  <link name="buste">
    <visual><origin xyz="0 0 0.07"/><geometry><box size="0.07 0.15 0.14"/></geometry><material name="bleu"/></visual>
    <collision><origin xyz="0 0 0.07"/><geometry><box size="0.07 0.15 0.14"/></geometry></collision>
    <inertial><origin xyz="0 0 0.07"/><mass value="0.45"/>
      <inertia ixx="1.579e-03" iyy="9.188e-04" izz="1.027e-03" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="fix_tete" type="fixed"><parent link="buste"/><child link="tete"/><origin xyz="0 0 0.14"/></joint>
  <link name="tete">
    <visual><origin xyz="0 0 0.05"/><geometry><sphere radius="0.04"/></geometry><material name="blanc"/></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><sphere radius="0.04"/></geometry></collision>
    <inertial><origin xyz="0 0 0.05"/><mass value="0.1"/>
      <inertia ixx="6.400e-05" iyy="6.400e-05" izz="6.400e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="hanche_lacet_g" type="revolute">
    <parent link="bassin"/><child link="hanche1_g"/>
    <origin xyz="0 0.05 -0.02" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.8" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="hanche1_g">
    <visual><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry><material name="noir"/></visual>
    <collision><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.015"/><mass value="0.06"/>
      <inertia ixx="1.250e-05" iyy="1.250e-05" izz="1.600e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="hanche_roulis_g" type="revolute">
    <parent link="hanche1_g"/><child link="hanche2_g"/>
    <origin xyz="0 0 -0.03" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.3" upper="0.6" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="hanche2_g">
    <visual><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry><material name="noir"/></visual>
    <collision><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.015"/><mass value="0.06"/>
      <inertia ixx="1.250e-05" iyy="1.250e-05" izz="1.600e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="hanche_tangage_g" type="revolute">
    <parent link="hanche2_g"/><child link="cuisse_g"/>
    <origin xyz="0 0 -0.03" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0.8" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="cuisse_g">
    <visual><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry><material name="blanc"/></visual>
    <collision><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.05"/><mass value="0.12"/>
      <inertia ixx="1.203e-04" iyy="1.123e-04" izz="3.250e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="genou_g" type="revolute">
    <parent link="cuisse_g"/><child link="tibia_g"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.0" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="tibia_g">
    <visual><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry><material name="blanc"/></visual>
    <collision><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.05"/><mass value="0.12"/>
      <inertia ixx="1.203e-04" iyy="1.123e-04" izz="3.250e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="cheville_tangage_g" type="revolute">
    <parent link="tibia_g"/><child link="cheville_g"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="cheville_g">
    <visual><origin xyz="0 0 -0.01"/><geometry><box size="0.04 0.04 0.02"/></geometry><material name="noir"/></visual>
    <collision><origin xyz="0 0 -0.01"/><geometry><box size="0.04 0.04 0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.01"/><mass value="0.06"/>
      <inertia ixx="1.000e-05" iyy="1.000e-05" izz="1.600e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="cheville_roulis_g" type="revolute">
    <parent link="cheville_g"/><child link="pied_g"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="pied_g">
    <visual><origin xyz="0.015 0 -0.025"/><geometry><box size="0.12 0.07 0.01"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0.015 0 -0.025"/><geometry><box size="0.12 0.07 0.01"/></geometry></collision>
    <inertial><origin xyz="0.015 0 -0.025"/><mass value="0.08"/>
      <inertia ixx="3.333e-05" iyy="9.667e-05" izz="1.287e-04" ixy="0" ixz="0" iyz="0"/></inertial>
    <contact><lateral_friction value="1.0"/><rolling_friction value="0.001"/><spinning_friction value="0.001"/></contact>
  </link>

  <joint name="hanche_lacet_d" type="revolute">
    <parent link="bassin"/><child link="hanche1_d"/>
    <origin xyz="0 -0.05 -0.02" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.8" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="hanche1_d">
    <visual><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry><material name="noir"/></visual>
    <collision><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.015"/><mass value="0.06"/>
      <inertia ixx="1.250e-05" iyy="1.250e-05" izz="1.600e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="hanche_roulis_d" type="revolute">
    <parent link="hanche1_d"/><child link="hanche2_d"/>
    <origin xyz="0 0 -0.03" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="0.3" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="hanche2_d">
    <visual><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry><material name="noir"/></visual>
    <collision><origin xyz="0 0 -0.015"/><geometry><box size="0.04 0.04 0.03"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.015"/><mass value="0.06"/>
      <inertia ixx="1.250e-05" iyy="1.250e-05" izz="1.600e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="hanche_tangage_d" type="revolute">
    <parent link="hanche2_d"/><child link="cuisse_d"/>
    <origin xyz="0 0 -0.03" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="0.8" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="cuisse_d">
    <visual><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry><material name="blanc"/></visual>
    <collision><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.05"/><mass value="0.12"/>
      <inertia ixx="1.203e-04" iyy="1.123e-04" izz="3.250e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="genou_d" type="revolute">
    <parent link="cuisse_d"/><child link="tibia_d"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.0" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="tibia_d">
    <visual><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry><material name="blanc"/></visual>
    <collision><origin xyz="0 0 -0.05"/><geometry><box size="0.035 0.045 0.1"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.05"/><mass value="0.12"/>
      <inertia ixx="1.203e-04" iyy="1.123e-04" izz="3.250e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="cheville_tangage_d" type="revolute">
    <parent link="tibia_d"/><child link="cheville_d"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.0" upper="1.0" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="cheville_d">
    <visual><origin xyz="0 0 -0.01"/><geometry><box size="0.04 0.04 0.02"/></geometry><material name="noir"/></visual>
    <collision><origin xyz="0 0 -0.01"/><geometry><box size="0.04 0.04 0.02"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.01"/><mass value="0.06"/>
      <inertia ixx="1.000e-05" iyy="1.000e-05" izz="1.600e-05" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <joint name="cheville_roulis_d" type="revolute">
    <parent link="cheville_d"/><child link="pied_d"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="1.0" velocity="7.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="pied_d">
    <visual><origin xyz="0.015 0 -0.025"/><geometry><box size="0.12 0.07 0.01"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0.015 0 -0.025"/><geometry><box size="0.12 0.07 0.01"/></geometry></collision>
    <inertial><origin xyz="0.015 0 -0.025"/><mass value="0.08"/>
      <inertia ixx="3.333e-05" iyy="9.667e-05" izz="1.287e-04" ixy="0" ixz="0" iyz="0"/></inertial>
    <contact><lateral_friction value="1.0"/><rolling_friction value="0.001"/><spinning_friction value="0.001"/></contact>
  </link>

</robot>
