<?xml version="1.0"?>
<!--
  Bras robotisé à 5 axes (formes simples, aucun mesh externe)
  Axe 1 : rotation de la base (lacet, axe Z)
  Axe 2 : épaule (tangage, axe Y)
  Axe 3 : coude (tangage, axe Y)
  Axe 4 : poignet (tangage, axe Y)
  Axe 5 : rotation du poignet (roulis, axe Z)
  Unités : mètres, kilogrammes, radians
-->
<robot name="bras_5axes">

  <!-- ===== Couleurs ===== -->
  <material name="gris_fonce"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.1 1"/></material>
  <material name="gris_clair"><color rgba="0.75 0.75 0.75 1"/></material>
  <material name="bleu"><color rgba="0.1 0.4 0.9 1"/></material>
  <material name="rouge"><color rgba="0.9 0.1 0.1 1"/></material>

  <!-- ===== Socle ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="gris_fonce"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025"/>
      <mass value="2.0"/>
      <inertia ixx="0.005417" iyy="0.005417" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== Axe 1 : rotation de la base ===== -->
  <joint name="axe1_base" type="revolute">
    <parent link="base_link"/>
    <child link="tourelle"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="50" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="tourelle">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.1"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="1.0"/>
      <inertia ixx="0.001458" iyy="0.001458" izz="0.00125" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== Axe 2 : épaule ===== -->
  <joint name="axe2_epaule" type="revolute">
    <parent link="tourelle"/>
    <child link="bras"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="40" velocity="1.5"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="bras">
    <!-- articulation visible -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.09"/></geometry>
      <material name="gris_fonce"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
      <material name="gris_clair"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.03" length="0.3"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="0.8"/>
      <inertia ixx="0.00618" iyy="0.00618" izz="0.00036" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== Axe 3 : coude ===== -->
  <joint name="axe3_coude" type="revolute">
    <parent link="bras"/>
    <child link="avant_bras"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="30" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.0"/>
  </joint>

  <link name="avant_bras">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.08"/></geometry>
      <material name="gris_fonce"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.125"/>
      <geometry><cylinder radius="0.025" length="0.25"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125"/>
      <geometry><cylinder radius="0.025" length="0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125"/>
      <mass value="0.6"/>
      <inertia ixx="0.003219" iyy="0.003219" izz="0.0001875" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== Axe 4 : poignet (tangage) ===== -->
  <joint name="axe4_poignet" type="revolute">
    <parent link="avant_bras"/>
    <child link="poignet"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="10" velocity="2.5"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <link name="poignet">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      <material name="gris_fonce"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.02" length="0.08"/></geometry>
      <material name="gris_clair"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.02" length="0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.3"/>
      <inertia ixx="0.00019" iyy="0.00019" izz="0.00006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== Axe 5 : rotation du poignet ===== -->
  <joint name="axe5_rotation_poignet" type="revolute">
    <parent link="poignet"/>
    <child link="bride"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="5" velocity="3.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="bride">
    <visual>
      <origin xyz="0 0 0.01"/>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
      <material name="bleu"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01"/>
      <geometry><cylinder radius="0.03" length="0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01"/>
      <mass value="0.1"/>
      <inertia ixx="0.0000258" iyy="0.0000258" izz="0.000045" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===== Outil (fixe) : point de référence de l'effecteur ===== -->
  <joint name="fixation_outil" type="fixed">
    <parent link="bride"/>
    <child link="outil"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="outil">
    <visual>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
      <material name="rouge"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02"/>
      <geometry><box size="0.04 0.04 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000133" iyy="0.0000133" izz="0.0000133" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

</robot>
